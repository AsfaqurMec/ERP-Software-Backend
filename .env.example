# ==========================================
# StockPilot Backend Environment Variables
# ==========================================

# Server Environment & Port
NODE_ENV=production
PORT=4000

# PostgreSQL Database (Neon, Supabase, Render PostgreSQL, or Railway)
DATABASE_URL="postgresql://user:password@hostname:5432/dbname?sslmode=require"

# JWT Authentication Secret
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-long"

# Frontend Client URL(s) - comma separated for multiple allowed origins
CLIENT_URL="https://your-frontend.vercel.app,http://localhost:3000"

# Cloudinary CDN (Image uploads for products, categories, logos, profiles)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Render / Cloud Anti-Sleep Keep-Alive
# Render sets RENDER_EXTERNAL_URL automatically!
# If deploying elsewhere or custom domain, you can set SERVER_URL
# RENDER_EXTERNAL_URL="https://your-backend-service.onrender.com"
# SERVER_URL="https://your-backend-service.onrender.com"
ENABLE_KEEP_ALIVE="true"
KEEP_ALIVE_INTERVAL_MINUTES="10"
